{
	"schemaVersion": 1,
	"id": "margin",
	"version": "${version}",
	"name": "Margin",
	"description": "Writes your coordinates along the bottom edge of held maps, and lets new maps start at a larger scale.",
	"authors": [
		"maihatsuu"
	],
	"contact": {
		"homepage": "https://github.com/maihatsuu/margin",
		"sources": "https://github.com/maihatsuu/margin"
	},
	"license": "CC0-1.0",
	"icon": "assets/margin/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"maihatsuu.margin.Margin"
		],
		"client": [
			"maihatsuu.margin.client.MarginClient"
		],
		"modmenu": [
			"maihatsuu.margin.client.MarginModMenu"
		]
	},
	"mixins": [
		"margin.mixins.json",
		{
			"config": "margin.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"cloth-config": "*",
		"modmenu": "*"
	}
}